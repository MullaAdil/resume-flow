NODE_ENV=production
PORT=5001

# DocumentDB connection (fill in after cluster creation)
# For MongoDB Atlas, use your existing connection string instead
MONGODB_URI=mongodb://<username>:<password>@<docdb-endpoint>:27017/resume-builder?tls=true&tlsCAFile=/home/ec2-user/rds-combined-ca-bundle.pem&retryWrites=false

# Auth
JWT_SECRET=<generate-a-strong-random-secret>

# Groq API
VITE_GROQ_API_KEY=<your-groq-api-key>

# OAuth (update redirect URIs in Google/GitHub consoles to match SERVER_URL)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>

# Frontend API Connection (For AWS Amplify or Static Hosting)
VITE_API_URL=http://54.226.97.39
VITE_API_BASE_URL=http://54.226.97.39

